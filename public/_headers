# Headers for Cloudflare Pages and Netlify
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/assets/*
  Cache-Control: public, max-age=31536000, immutable
